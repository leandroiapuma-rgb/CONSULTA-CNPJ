# Porta em que o backend roda localmente
PORT=3000

# Provedor de Inscrição Estadual (opcional).
# Sem estas variáveis definidas, a consulta de IE responde de forma
# honesta que a informação não está disponível, sem inventar dados.
# Preencha com as credenciais do provedor real que você escolher
# (ex.: CNPJá, Casa dos Dados, IE Fácil, ReceitaWS Pro, etc).
IE_PROVIDER_URL=
IE_PROVIDER_API_KEY=
